# Xiaomi Smart Air Purifier 4 Compact (xiaomi.airp.cpa4m / zhimi.airp.cpa4)
# Copy to .env and fill in the token from the token extractor output.

# The 32-character token for the purifier
PURIFIER_TOKEN=paste_your_32_character_token_here

# Optional: the purifier's IP address. Leave as-is to find it automatically;
# the script saves the IP here once found and re-finds it if it changes.
PURIFIER_IP=192.168.x.x
