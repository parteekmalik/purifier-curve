# Xiaomi Smart Air Purifier 4 Compact (zhimi.airp.cpa4)
# Copy to .env and fill in both values from the token extractor output.

# The purifier's IP address on your network (reserve it in your router so it doesn't change)
PURIFIER_IP=192.168.x.x

# The 32-character token for the zhimi.airp.cpa4 device
PURIFIER_TOKEN=paste_your_32_character_token_here
